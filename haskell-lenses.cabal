name:                  haskell-lenses
version:               0.1.0.0
license:               BSD3
license-file:          LICENSE
author:                Rudi Horn
maintainer:            dyn-git@rudi-horn.de
build-type:            Simple
extra-source-files:    CHANGELOG.md
cabal-version:         >=1.10

library
  exposed-modules:
    Common
    Delta
    FunDep
    Label
    Lens
    Lens.Database.Base
    Lens.Database.Postgres
    Lens.Database.Query
    Lens.Debug.Timing
    Lens.FunDep.Affected
    Lens.Helpers.Format
    Lens.Predicate.Base
    Lens.Predicate.Compile
    Lens.Predicate.Dynamic
    Lens.Predicate.Hybrid
    Lens.Predicate.Precedence
    Lens.Put.Incremental
    Lens.Record.Base
    Lens.Record.Sorted
    Lens.Types
    Tables
    Value

  default-extensions:
    AllowAmbiguousTypes
    ConstraintKinds
    DataKinds
    FlexibleContexts
    FlexibleInstances
    GADTs
    KindSignatures
    MultiParamTypeClasses
    OverloadedLabels
    OverloadedStrings
    PolyKinds
    ScopedTypeVariables
    StandaloneDeriving
    TypeApplications
    TypeFamilies
    TypeInType
    TypeOperators
    UndecidableInstances

  build-depends:
      base        >=4.12 && <4.13
    , bytestring  >=0.10 && <0.11
    , containers  >=0.6  && <0.7
    , mtl         >=2.2  && <2.3
    , text        >=1.2  && <1.3

  default-language:   Haskell2010
