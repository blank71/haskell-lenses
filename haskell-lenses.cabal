name:               haskell-lenses
version:            0.1.0.0
license:            BSD3
license-file:       LICENSE
author:             Rudi Horn
maintainer:         dyn-git@rudi-horn.de
build-type:         Simple
extra-source-files: CHANGELOG.md
cabal-version:      >=1.10

library
  exposed-modules:
    Benchmark
    Common
    Delta
    FunDep
    Label
    Lens
    Lens.Database.Base
    Lens.Database.Postgres
    Lens.Database.Query
    Lens.Database.Table
    Lens.Debug.Timing
    Lens.FunDep.Affected
    Lens.Helpers.Format
    Lens.Predicate.Base
    Lens.Predicate.Compile
    Lens.Predicate.Dynamic
    Lens.Predicate.Hybrid
    Lens.Predicate.Precedence
    Lens.Put.Classic
    Lens.Put.Incremental
    Lens.Record.Base
    Lens.Record.Sorted
    Lens.Types
    Scratch
    Tables
    -- TicketSystem
    Value

  default-extensions:
    AllowAmbiguousTypes
    ConstraintKinds
    DataKinds
    FlexibleContexts
    FlexibleInstances
    GADTs
    KindSignatures
    MultiParamTypeClasses
    OverloadedLabels
    OverloadedStrings
    PolyKinds
    ScopedTypeVariables
    StandaloneDeriving
    TypeApplications
    TypeFamilies
    TypeInType
    TypeOperators
    UndecidableInstances

  build-depends:
      base               >=4.14    && <4.15
    , bytestring         >=0.10    && <0.11
    , containers         >=0.6     && <0.7
    , deepseq            >=1.4     && <1.5
    , ghc-prim
    , mtl                >=2.2     && <2.3
    , multiset           >=0.3     && <0.4
    , postgresql-simple  >=0.6     && <0.7
    , random
    , text               >=1.2     && <1.3
    , text-format        >=0.3     && <0.4
    , time               >=1.9     && <1.10
    , type-level-sets    ==0.8.9.0
    , utf8-string        >=1.0     && <1.1

  default-language:   Haskell2010
